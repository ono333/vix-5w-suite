# ── Helpers ───────────────────────────────────────────────────────────────────

def _load(f: Path) -> list:
    if not f.exists():
        return []
    try:
        return json.loads(f.read_text())
    except Exception:
        return []


def _dte(expiry_str: str) -> int:
    try:
        return max((date.fromisoformat(expiry_str) - date.today()).days, 0)
    except Exception:
        return 999


def _norm_cdf(x: float) -> float:
    import math
    t = 1.0 / (1.0 + 0.2316419 * abs(x))
    p = t * (0.319381530 + t * (-0.356563782 + t * (1.781477937
        + t * (-1.821255978 + t * 1.330274429))))
    pdf = exp(-0.5 * x * x) / sqrt(2 * math.pi)
    cdf = 1.0 - pdf * p
    return cdf if x >= 0 else 1.0 - cdf


def _bs_put_price(S, K, T, sigma=1.20, r=0.05) -> float:
    if T <= 0:
        return max(K - S, 0.0)
    d1 = (log(S / K) + (r + 0.5 * sigma ** 2) * T) / (sigma * sqrt(T))
    d2 = d1 - sigma * sqrt(T)
    return round(K * exp(-r * T) * _norm_cdf(-d2) - S * _norm_cdf(-d1), 2)


def _bs_call_price(S, K, T, sigma=1.20, r=0.05) -> float:
    if T <= 0:
        return max(S - K, 0.0)
    d1 = (log(S / K) + (r + 0.5 * sigma ** 2) * T) / (sigma * sqrt(T))
    d2 = d1 - sigma * sqrt(T)
    return round(S * _norm_cdf(d1) - K * exp(-r * T) * _norm_cdf(d2), 2)


# ── Data collectors ───────────────────────────────────────────────────────────

def _get_market_state() -> dict:
    """Fetch live VIX / UVXY / regime from vol_triangle snapshot."""
    try:
        from vol_triangle import capture_snapshot
        snap = capture_snapshot(force=True)
        return {
            "vix":      snap.vix,
            "vix_pct":  snap.vix_pct,
            "uvxy":     snap.uvxy,
            "vvix":     snap.vvix,
            "spike":    snap.spike_score,
            "regime":   "EXTREME" if snap.vix_pct >= 0.80 else
                        "HIGH"    if snap.vix_pct >= 0.60 else
                        "MEDIUM"  if snap.vix_pct >= 0.40 else
                        "LOW"     if snap.vix_pct >= 0.20 else "ULTRA_LOW",
            "collapse": getattr(snap, "collapse_flag", False),
            "crisis_harvest": getattr(snap, "crisis_harvest", False),
            "ok": True,
        }
    except Exception as e:
        return {"ok": False, "error": str(e),
                "vix": 0, "uvxy": 0, "vix_pct": 0,
                "regime": "UNKNOWN", "spike": 0}


def _get_real_positions() -> list:
    """Load open real trade positions."""
    try:
        from real_trade_log import get_real_trade_log
        rtl = get_real_trade_log()
        pos = rtl.open_positions()
        if isinstance(pos, dict):
            return list(pos.values())
        return list(pos or [])
    except Exception:
        return []


def _get_assignments(mode: str) -> list:
    f = STORE_DIR / f"assignments_{mode}.json"
    return [r for r in _load(f) if r.get("status") == "open"]


def _get_harvest_log(mode: str) -> list:
    f = STORE_DIR / f"harvest_log_{mode}.json"
    return [r for r in _load(f) if r.get("status") == "open"]


# ── Alert generators ──────────────────────────────────────────────────────────

def _regime_alerts(ms: dict) -> List[str]:
    bullets = []
    regime  = ms.get("regime", "UNKNOWN")
    vix     = ms.get("vix", 0)
    vix_pct = ms.get("vix_pct", 0)
    spike   = ms.get("spike", 0)

    if regime in ("EXTREME", "HIGH"):
        bullets.append(
            f"🔴 REGIME: <strong>{regime}</strong> — VIX {vix:.2f} "
            f"({vix_pct*100:.0f}th percentile) · Spike score {spike}/100"
        )
    else:
        bullets.append(
            f"🟢 Regime: <strong>{regime}</strong> — VIX {vix:.2f} "
            f"({vix_pct*100:.0f}th percentile)"
        )

    if ms.get("collapse"):
        bullets.append("⚠️ COLLAPSE FLAG active — vol may be peaking, consider defensive posture")

    if ms.get("crisis_harvest"):
        bullets.append("🌾 CRISIS HARVEST mode active — elevated premium available")

    return bullets


def _v4_signal(ms: dict) -> List[str]:
    bullets = []
    vix_pct = ms.get("vix_pct", 0)
    uvxy    = ms.get("uvxy", 0)
    regime  = ms.get("regime", "")

    if regime not in ("EXTREME", "HIGH") or vix_pct < 0.75:
        bullets.append("⏸ V4 Tail Hunter: not yet activated — VIX percentile below 75%")
        return bullets

    # Suggest diagonal: long ATM LEAP + short far OTM call
    long_strike  = round(uvxy * 1.00, 1)
    short_strike = round(uvxy * 1.30, 1)

    long_dte  = 90
    short_dte = 21
    sigma     = min(2.60, max(0.80, (ms.get("vix", 25) / 100) * 4.5))

    long_px  = _bs_call_price(uvxy, long_strike,  long_dte  / 365, sigma)
    short_px = _bs_call_price(uvxy, short_strike, short_dte / 365, sigma)
    net_debit = round(long_px - short_px, 2)

    long_exp  = (date.today() + timedelta(days=long_dte)).strftime("%b %d")
    short_exp = (date.today() + timedelta(days=short_dte)).strftime("%b %d")

    bullets.append(
        f"🎯 V4 ENTRY SIGNAL — Regime: <strong>{regime}</strong> "
        f"({vix_pct*100:.0f}th pct)"
    )
    bullets.append(
        f"&nbsp;&nbsp;&nbsp;↳ Buy {long_strike}C {long_exp} (~${long_px:.2f}) "
        f"/ Sell {short_strike}C {short_exp} (~${short_px:.2f})"
    )
    bullets.append(
        f"&nbsp;&nbsp;&nbsp;↳ Net debit ~${net_debit:.2f} · σ={sigma*100:.0f}% · "
        f"Long DTE {long_dte}d / Short DTE {short_dte}d"
    )

    if ms.get("collapse"):
        bullets.append(
            "&nbsp;&nbsp;&nbsp;⚠️ Collapse flag active — consider waiting 1 session "
            "for confirmation before entering V4"
        )

    return bullets


def _assignment_alerts(ms: dict) -> List[str]:
    bullets = []
    uvxy    = ms.get("uvxy", 0)

    for mode in ("real", "paper"):
        asgns = _get_assignments(mode)
        label = "REAL" if mode == "real" else "PAPER"
        for a in asgns:
            shares     = a.get("shares", 0)
            entry_px   = a.get("entry_price", 0)
            upnl       = shares * (uvxy - entry_px) if uvxy else 0
            upnl_pct   = upnl / (abs(shares) * entry_px) * 100 if entry_px else 0
            direction  = "SHORT" if shares < 0 else "LONG"
            pnl_icon   = "✅" if upnl >= 0 else "🔴"

            bullets.append(
                f"{pnl_icon} [{label}] Assignment #{a['id'][:8]} — "
                f"{direction} {abs(shares):,} shares @ ${entry_px:.3f} · "
                f"P&L <strong>${upnl:+,.0f} ({upnl_pct:+.1f}%)</strong>"
            )

            # Roll / close suggestions
            if direction == "SHORT" and uvxy and upnl_pct < -15:
                bullets.append(
                    f"&nbsp;&nbsp;&nbsp;⚠️ Short position down {upnl_pct:.1f}% — "
                    f"consider stop or roll"
                )
            if direction == "SHORT" and uvxy and upnl_pct > 20:
                bullets.append(
                    f"&nbsp;&nbsp;&nbsp;💚 Short position up {upnl_pct:.1f}% — "
                    f"consider taking profit"
                )

    if not any(_get_assignments(m) for m in ("real","paper")):
        bullets.append("✅ No open assignments")

    return bullets


def _option_expiry_alerts(ms: dict) -> List[str]:
    bullets = []
    uvxy = ms.get("uvxy", 0)

    for mode in ("real", "paper"):
        hlogs = _get_harvest_log(mode)
        label = "REAL" if mode == "real" else "PAPER"
        for h in hlogs:
            dte        = _dte(h.get("expiry", ""))
            opt_type   = h.get("option_type", "")
            strike     = h.get("strike", 0)
            credit     = h.get("credit", 0)
            contracts  = h.get("contracts", 1)
            expiry     = h.get("expiry", "")

            # Estimate current value
            if uvxy and dte > 0:
                sigma = min(2.60, max(0.80, (ms.get("vix", 25) / 100) * 4.5))
                T = dte / 365
                if opt_type == "PUT":
                    curr_px = _bs_put_price(uvxy, strike, T, sigma)
                else:
                    curr_px = _bs_call_price(uvxy, strike, T, sigma)
                curr_pnl = round((credit - curr_px) * contracts * 100, 0)
                pnl_str  = f" · Est P&L <strong>${curr_pnl:+,.0f}</strong>"
            else:
                curr_px  = 0
                pnl_str  = ""

            if dte <= 3:
                icon = "🚨"
                note = "EXPIRING SOON — close or let expire"
            elif dte <= 7:
                icon = "⚠️"
                note = "DTE ≤ 7 — monitor closely"
            else:
                icon = "📋"
                note = f"{dte} DTE"

            bullets.append(
                f"{icon} [{label}] {opt_type} {strike} exp {expiry} "
                f"({note}) · {contracts}ct · sold ${credit:.2f}"
                f"{pnl_str}"
            )

            # ITM warning
            if opt_type == "PUT" and uvxy and uvxy < strike:
                bullets.append(
                    f"&nbsp;&nbsp;&nbsp;🔴 PUT IS ITM — UVXY ${uvxy:.2f} below "
                    f"strike ${strike} — assignment risk if held to expiry"
                )
            if opt_type == "CALL" and uvxy and uvxy > strike:
                bullets.append(
                    f"&nbsp;&nbsp;&nbsp;🔴 CALL IS ITM — UVXY ${uvxy:.2f} above "
                    f"strike ${strike}"
                )

    if not any(_get_harvest_log(m) for m in ("real","paper")):
        bullets.append("✅ No open option positions")

    return bullets


def _position_alerts(ms: dict) -> List[str]:
    """Alerts from real trade log diagonal positions."""
    bullets = []
    try:
        positions = _get_real_positions()
        if not positions:
            bullets.append("✅ No open diagonal positions")
            return bullets

        for pos in positions:
            pid  = getattr(pos, "position_id", "?")[:8]
            var  = getattr(pos, "variant_name", getattr(pos, "variant_id", "?"))
            pnl  = getattr(pos, "total_pnl", 0)

            # Short leg DTE
            short_exp = getattr(pos, "current_short_expiration", None)
            short_dte_val = _dte(str(short_exp)) if short_exp else 999

            pnl_icon = "✅" if pnl >= 0 else "🔴"
            bullets.append(
                f"{pnl_icon} [{var}] #{pid} · P&L <strong>${pnl:+,.0f}</strong> "
                f"· Short DTE {short_dte_val}d"
            )

            if short_dte_val <= 4:
                bullets.append(
                    f"&nbsp;&nbsp;&nbsp;🔄 ROLL NOW — short leg expires in "
                    f"{short_dte_val} days"
                )
            elif short_dte_val <= 7:
                bullets.append(
                    f"&nbsp;&nbsp;&nbsp;⚠️ Roll soon — {short_dte_val} DTE on short leg"
                )

    except Exception as e:
        bullets.append(f"⚠️ Could not load positions: {e}")

    return bullets


# ── Email builder ─────────────────────────────────────────────────────────────

def build_alert_email(ms: dict) -> tuple[str, str]:
    """Returns (subject, html_body)."""
    now     = datetime.now().strftime("%b %d %Y %I:%M %p")
    regime  = ms.get("regime", "UNKNOWN")
    vix     = ms.get("vix", 0)
    uvxy    = ms.get("uvxy", 0)

    regime_color = {
        "EXTREME":  "#ef4444",
        "HIGH":     "#f97316",
        "MEDIUM":   "#f59e0b",
        "LOW":      "#3b82f6",
        "ULTRA_LOW":"#22c55e",
    }.get(regime, "#94a3b8")

    subject = f"[VIX Suite] {regime} · VIX {vix:.1f} · UVXY ${uvxy:.2f} · {now}"

    # Collect all bullet sections
    sections = [
        ("🌊 Market Regime",          _regime_alerts(ms)),
        ("🎯 V4 Entry Signal",        _v4_signal(ms)),
        ("📊 Diagonal Positions",     _position_alerts(ms)),
        ("📋 Assignment Positions",   _assignment_alerts(ms)),
        ("⏰ Option Expiry Warnings", _option_expiry_alerts(ms)),
    ]

    def _bullets_html(items: List[str]) -> str:
        return "".join(
            f"<li style='margin:6px 0;color:#e2e8f0;font-size:14px;'>{b}</li>"
            for b in items
        )

    sections_html = ""
    for title, bullets in sections:
        sections_html += f"""
        <div style="margin-bottom:20px;">
            <div style="font-size:15px;font-weight:700;color:#f1f5f9;
                        border-bottom:1px solid #334155;padding-bottom:6px;
                        margin-bottom:10px;">{title}</div>
            <ul style="margin:0;padding-left:18px;">
                {_bullets_html(bullets)}
            </ul>
        </div>"""

    html = f"""
<!DOCTYPE html>
<html>
<body style="background:#0f172a;font-family:Arial,sans-serif;padding:24px;margin:0;">
  <div style="max-width:680px;margin:0 auto;">

    <!-- Header -->
    <div style="background:{regime_color};border-radius:10px;
                padding:16px 22px;margin-bottom:20px;">
      <div style="font-size:22px;font-weight:900;color:white;">
        📊 VIX 5W Suite — Action Alert
      </div>
      <div style="color:rgba(255,255,255,0.85);font-size:13px;margin-top:4px;">
        {now} &nbsp;|&nbsp; Regime: <strong>{regime}</strong>
        &nbsp;|&nbsp; VIX {vix:.2f}
        &nbsp;|&nbsp; UVXY ${uvxy:.2f}
      </div>
    </div>

    <!-- Sections -->
    <div style="background:#1e293b;border-radius:10px;
                padding:20px 24px;border:1px solid #334155;">
      {sections_html}
    </div>

    <!-- Footer -->
    <div style="margin-top:14px;font-size:11px;color:#475569;text-align:center;">
      VIX 5% Weekly Suite · Generated {now} ·
      This is a reminder alert, not financial advice.
    </div>

  </div>
</body>
</html>"""

    return subject, html


# ── Send ──────────────────────────────────────────────────────────────────────

def send_alert(dry_run: bool = False) -> bool:
    """Fetch market state, build alert, send email. Returns True on success."""
    print(f"[{datetime.now():%H:%M:%S}] Fetching market state…")
    ms = _get_market_state()

    if not ms["ok"]:
        print(f"⚠️  Market data unavailable: {ms.get('error')}")

    subject, html = build_alert_email(ms)
    print(f"Subject: {subject}")

    if dry_run:
        print("\n--- DRY RUN — email not sent ---")
        # Print plain text version
        for line in html.split("\n"):
            import re
            text = re.sub(r"<[^>]+>", "", line).strip()
            if text:
                print(text)
        return True

    try:
        from daily_signal import send_email
        ok = send_email(
            html_body = html,
            to_email  = TO_EMAIL,
            subject   = subject,
            smtp_user = SMTP_USER,
            smtp_pass = SMTP_PASS,
        )
        return ok
    except Exception as e:
        print(f"❌ Send failed: {e}")
        return False


